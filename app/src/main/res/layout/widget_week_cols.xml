<?xml version="1.0" encoding="utf-8"?>
<!--
  Week widget (cols). The image is drawn by WeekRenderer; this overlay only adds tap
  targets. Weights 12 / 88 MUST match WeekLayout.HEADER_FRAC.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/calendar_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_week_label"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/header_tap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="12" />

        <LinearLayout
            android:id="@+id/days"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="88"
            android:orientation="horizontal" />
    </LinearLayout>
</FrameLayout>
