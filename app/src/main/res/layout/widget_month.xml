<?xml version="1.0" encoding="utf-8"?>
<!--
  The whole calendar is drawn into one image (calendar_image). The transparent
  overlay on top only provides tap targets. Its weights (20 / 5 / 75) MUST match
  MonthLayout.HEADER_FRAC / DOW_FRAC / GRID_FRAC in MonthRenderer.kt.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/calendar_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_month_label"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="20"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/nav_prev"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/nav_today"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3" />

            <FrameLayout
                android:id="@+id/nav_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Weekday labels (not tappable). RemoteViews can't inflate a plain View, so FrameLayout. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5" />

        <LinearLayout
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="75"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
