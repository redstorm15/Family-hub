<?xml version="1.0" encoding="utf-8"?>
<!-- Sticky board: one image drawn by StickyRenderer, with a tap grid on top (one cell per note) and the + button above that. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/calendar_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_sticky_label"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" />

    <!-- Tap target for the floating + (drawn in the image); size and position set in code. -->
    <FrameLayout
        android:id="@+id/add_button"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|start" />
</FrameLayout>
